AZURE_API_KEY=your_azure_api_key_here
AZURE_API_KEY2=your_azure_api_key2_here
AZURE_BASE_URL=https://your-azure-apim-instance.azure-api.net/
AZURE_API_VERSION=2024-10-21
CLAUDE_CODE_USE_FOUNDRY=1
CLAUDE_CODE_SKIP_FOUNDRY_AUTH=1
CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
#ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource-name
ANTHROPIC_FOUNDRY_BASE_URL=https://your-azure-apim-instance.azure-api.net/anthropic
ANTHROPIC_FOUNDRY_API_KEY=your_anthropic_foundry_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# HuggingFace token — required for gated pyannote models
# Get at https://huggingface.co/settings/tokens
# Must also accept license at https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=your_huggingface_token_here
# NOTE: HF_HUB_DISABLE_SYMLINKS_WARNING used to be set here. It is deliberately
# gone: without symlink support the HuggingFace cache COPIES blobs instead of
# linking them, so every model referenced twice occupies disk twice. Suppressing
# the warning hid the duplication rather than fixing it. The fix is
# Settings > System > For developers > Developer Mode > On (no reboot needed),
# which is already enabled on the Windows workstation. Leave the warning
# unsuppressed so a future regression is visible.

# --- Pipeline paths (see paths.py) -------------------------------------------
# Where GGUF / safetensors model weights live. REQUIRED to run any LLM script.
# Everything else defaults to a location inside the repository and only needs
# setting for unusual layouts (a read-only checkout, cluster scratch, etc).
# Do NOT quote these values: load_env.ps1 does not strip quotes.
#   Windows: D:\LLM     Linux: /home/you/models     Roar: $SCRATCH/models
HODL_MODELS_ROOT=D:\LLM

# Optional overrides, all defaulting to <repo>/downloads/...
#HODL_DOWNLOADS_DIR=
#HODL_COMMENTS_DIR=
#HODL_OUTPUTS_ROOT=
#HODL_THEMES_MD=
#HODL_PROMPTS_DIR=

# Set to 1 to SHA-256 the model weights into each output's provenance block.
# Off by default: hashing a 10 GB GGUF adds 30-60 s to every run.
#HODL_HASH_WEIGHTS=1